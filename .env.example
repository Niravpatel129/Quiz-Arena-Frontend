# Quiz Arena Frontend environment example
# Copy this file to .env for local development and fill in safe development values.
# Do not commit real credentials.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000
EXPO_PUBLIC_APP_SCHEME=quizarena

# Monitoring
EXPO_PUBLIC_SENTRY_DSN=

# Ads / monetization
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=

# Store / platform identifiers
EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER=com.example.quizarena
EXPO_PUBLIC_ANDROID_PACKAGE=com.example.quizarena
